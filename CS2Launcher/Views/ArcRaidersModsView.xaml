<UserControl x:Class="CS2Launcher.Views.ArcRaidersModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CS2Launcher.ViewModels"
             xmlns:m="clr-namespace:CS2Launcher.Models.ARCRaiders"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:ArcRaidersViewModel}">

    <UserControl.Background>
        <SolidColorBrush Color="#0E0E10" />
    </UserControl.Background>

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type m:OnlineMod}">
            <Border Margin="0,0,0,8"
                    Background="{StaticResource BgLightBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Иконка категории -->
                    <Border Grid.Column="0"
                            Width="56" Height="56"
                            Background="{Binding CategoryColor, Converter={x:Static vm:StringToBrushConverter.Instance}}"
                            CornerRadius="6"
                            Margin="0,0,14,0">
                        <TextBlock Text="📦"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Описание -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <Border Background="{Binding CategoryColor, Converter={x:Static vm:StringToBrushConverter.Instance}}"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>

                            <TextBlock Text=" • v"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Version}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding Description}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,6"
                                   MaxWidth="400" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="by "
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Author}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" • "
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Stars}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Rating, StringFormat=' {0:F1}'}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" • ↓ "
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FormattedDownloads}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" • 💾 "
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FormattedSize}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Прогресс-бар (когда качается) -->
                        <ProgressBar Value="{Binding DownloadProgress}"
                                     Maximum="100"
                                     Height="3"
                                     Margin="0,6,0,0"
                                     Visibility="{Binding IsDownloading,
                                                          Converter={x:Static vm:BoolToVisConverter.Instance}}" />
                    </StackPanel>

                    <!-- Кнопка действия -->
                    <Button Grid.Column="2"
                            VerticalAlignment="Center"
                            MinWidth="120"
                            Margin="14,0,0,0"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="16,10"
                            Cursor="Hand"
                            Command="{Binding DataContext.DownloadOnlineModCommand,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding IsDownloading,
                                                Converter={x:Static vm:InverseBoolConverter.Instance}}"
                            Visibility="{Binding IsInstalled,
                                                Converter={x:Static vm:InverseBoolToVisConverter.Instance}}">
                        <TextBlock Text="Скачать"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Button>

                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="4"
                            Padding="14,8"
                            Margin="14,0,0,0"
                            Visibility="{Binding IsInstalled,
                                                Converter={x:Static vm:BoolToVisConverter.Instance}}">
                        <TextBlock Text="✓ Установлен"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,32,32,16">

        <StackPanel>

            <!-- Header -->
            <TextBlock Text="Браузер модов"
                       FontFamily="{StaticResource PrimaryFont}"
                       FontSize="32"
                       FontWeight="Black"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <TextBlock Text="Устанавливайте моды прямо из лаунчера — без браузера"
                       FontFamily="{StaticResource PrimaryFont}"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,24" />

            <!-- Статус сообщения -->
            <Border Background="#161620"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage,
                                          Converter={x:Static vm:StringToVisConverter.Instance}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="12"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>

            <!-- Поиск -->
            <Border Style="{StaticResource CardPanel}"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="🔍"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Style="{StaticResource FaceitTextBox}"
                                 Width="300"
                                 Text="{Binding ModFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по имени, категории, автору" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshModsCommand}"
                                Margin="0,0,8,0">
                            <TextBlock Text="↻ Обновить" />
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenModsFolderCommand}"
                                Margin="0,0,8,0">
                            <TextBlock Text="📁 Папка" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallModCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" Margin="0,0,6,0" />
                                <TextBlock Text="Свой .pak" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Список онлайн-модов -->
            <ItemsControl ItemsSource="{Binding FilteredOnlineMods}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Подсказка -->
            <TextBlock Text="💡 Категории: Texture / Sound / UI / Gameplay / Map. Ищите по имени или автору в поле выше."
                       FontFamily="{StaticResource PrimaryFont}"
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0" />

            <!-- ============================================================ -->
            <!-- УСТАНОВЛЕННЫЕ МОДЫ                                           -->
            <!-- ============================================================ -->
            <TextBlock Text="Установленные моды"
                       FontFamily="{StaticResource PrimaryFont}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,32,0,12" />

            <!-- Сводка -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource BgDarkBrush}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="ВСЕГО МОДОВ"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextDimBrush}" />
                        <TextBlock Text="{Binding ModCatalog.TotalCount}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource BgDarkBrush}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="АКТИВНЫХ"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextDimBrush}" />
                        <TextBlock Text="{Binding ModCatalog.EnabledCount}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource BgDarkBrush}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="РАЗМЕР"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="9"
                                   Foreground="{StaticResource TextDimBrush}" />
                        <TextBlock Text="{Binding ModCatalog.TotalSizeFormatted}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Список установленных модов -->
            <Border Background="#0A0A0C"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="120">
                <ItemsControl ItemsSource="{Binding ModCatalog.Mods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:TextureMod}">
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         Fill="{StaticResource SuccessBrush}"
                                         Margin="0,0,12,0"
                                         Visibility="{Binding IsEnabled,
                                                              Converter={x:Static vm:BoolToVisConverter.Instance}}" />
                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         Fill="{StaticResource TextDimBrush}"
                                         Margin="0,0,12,0"
                                         Visibility="{Binding IsEnabled,
                                                              Converter={x:Static vm:InverseBoolToVisConverter.Instance}}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding FormattedSize, StringFormat='Размер: {0}'}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding FormattedSize}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <CheckBox Grid.Column="3"
                                          Style="{StaticResource FaceitCheckbox}"
                                          IsChecked="{Binding IsEnabled}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModCatalog.TotalCount}"
                                             Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <StackPanel VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,30">
                                                    <TextBlock Text="📦"
                                                               FontSize="40"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,12" />
                                                    <TextBlock Text="Нет установленных модов"
                                                               FontFamily="{StaticResource PrimaryFont}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextDimBrush}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="Выберите мод выше или установите свой .pak файл"
                                                               FontFamily="{StaticResource PrimaryFont}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextDimBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
