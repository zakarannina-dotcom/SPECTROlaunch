<UserControl x:Class="CS2Launcher.Views.ArcRaidersConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CS2Launcher.ViewModels"
             xmlns:m="clr-namespace:CS2Launcher.Models.ARCRaiders"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:ArcRaidersViewModel}">

    <UserControl.Background>
        <SolidColorBrush Color="#0E0E10" />
    </UserControl.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,32,32,16">

        <StackPanel>

            <!-- Header -->
            <TextBlock Text="Настройки графики ARC Raiders"
                       FontFamily="{StaticResource PrimaryFont}"
                       FontSize="32"
                       FontWeight="Black"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <TextBlock Text="Выберите пресет под ваше железо — он автоматически применится к игре"
                       FontFamily="{StaticResource PrimaryFont}"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,32" />

            <!-- Статус сообщения -->
            <Border Background="#161620"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage,
                                          Converter={x:Static vm:StringToVisConverter.Instance}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="12"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>

            <!-- Пресеты графики -->
            <Border Style="{StaticResource CardPanel}"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Пресеты графики"
                               Style="{StaticResource SubHeaderText}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Кликните по карточке — настройки применятся автоматически"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"
                               Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:GraphicsPreset}">
                                <Border Margin="0,0,8,0"
                                        Background="{StaticResource BgLightBrush}"
                                        BorderBrush="{Binding AccentColor, Converter={x:Static vm:StringToBrushConverter.Instance}}"
                                        BorderThickness="2,0,0,0"
                                        CornerRadius="4"
                                        Padding="14,12"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ApplyPresetCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding HardwareTier}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="{Binding AccentColor, Converter={x:Static vm:StringToBrushConverter.Instance}}"
                                                   Margin="0,2,0,8" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0">
                                            <TextBlock Text="FPS limit: "
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextDimBrush}" />
                                            <TextBlock Text="{Binding FrameRateLimit}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Подробные настройки (read-only — отображают текущий пресет) -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Подробные параметры пресета"
                               Style="{StaticResource SubHeaderText}"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Resolution Quality: "
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="{Binding SelectedPreset.ResolutionQuality}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="View Distance: "
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="{Binding SelectedPreset.ViewDistance}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Anti-Aliasing: "
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="{Binding SelectedPreset.AntiAliasing}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Shadow Quality: "
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="{Binding SelectedPreset.ShadowQuality}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Texture Quality: "
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="{Binding SelectedPreset.TextureQuality}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Effects Quality: "
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="{Binding SelectedPreset.EffectsQuality}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Foliage Quality: "
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="{Binding SelectedPreset.FoliageQuality}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Shading Quality: "
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="{Binding SelectedPreset.ShadingQuality}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="💡 Пресет записывается в GameUserSettings.ini в папке игры"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
