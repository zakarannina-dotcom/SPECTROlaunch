<UserControl x:Class="CS2Launcher.Views.ArcRaidersLaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CS2Launcher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:ArcRaidersViewModel}">

    <UserControl.Background>
        <SolidColorBrush Color="#0E0E10" />
    </UserControl.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,32,32,16">

        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Лого ARC -->
                <Border Grid.Column="0"
                        Width="64" Height="64"
                        CornerRadius="8"
                        Background="#3D3D44"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="2">
                    <TextBlock Text="AR"
                               FontSize="22"
                               FontWeight="Black"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="ARC Raiders"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="32"
                               FontWeight="Black"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Embark Studios • Extraction shooter"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="13"
                               Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>

                <!-- Status indicator -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,6">
                        <Ellipse Width="10" Height="10"
                                 Margin="0,0,6,0"
                                 Fill="{StaticResource SuccessBrush}"
                                 Visibility="{Binding IsInstalled,
                                                      Converter={x:Static vm:BoolToVisConverter.Instance}}" />
                        <Ellipse Width="10" Height="10"
                                 Margin="0,0,6,0"
                                 Fill="{StaticResource TextDimBrush}"
                                 Visibility="{Binding IsInstalled,
                                                      Converter={x:Static vm:InverseBoolToVisConverter.Instance}}" />
                        <TextBlock Text="{Binding IsInstalled,
                                                    StringFormat='Установлена: {0}',
                                                    FallbackValue=Не установлена}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10"
                                 Margin="0,0,6,0"
                                 Fill="{StaticResource SuccessBrush}"
                                 Visibility="{Binding IsRunning,
                                                      Converter={x:Static vm:BoolToVisConverter.Instance}}" />
                        <TextBlock Text="{Binding IsRunning,
                                                    StringFormat='Запущена: {0}',
                                                    FallbackValue=Не запущена}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Big Play card -->
            <Border Style="{StaticResource CardPanel}"
                    Margin="0,0,0,24"
                    Height="220">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Готовы к вылазке?"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="36"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Соберите команду, соберите лут, выживите против ARC"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Embark Studios • Unreal Engine 5 • Free to Play"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,12,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                MinWidth="220">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding LaunchCommand}"
                                FontSize="20"
                                FontWeight="Black"
                                Padding="40,28"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="20" Margin="0,0,12,0" />
                                <TextBlock Text="ИГРАТЬ" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseGameCommand}"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Закрыть игру" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Информация об игре -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Информация"
                               Style="{StaticResource SubHeaderText}"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="AppID Steam:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="Путь установки:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="Движок:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="Жанр:" Style="{StaticResource LabelStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="110"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding GamePath, FallbackValue=Не найден}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Unreal Engine 5"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Co-op PvE Extraction Shooter"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
