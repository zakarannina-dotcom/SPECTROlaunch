<Window x:Class="CS2Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CS2Launcher.ViewModels"
        xmlns:views="clr-namespace:CS2Launcher.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CS2 Launcher"
        Height="720" Width="1180"
        MinHeight="640" MinWidth="1000"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        ResizeMode="CanResizeWithGrip">

    <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- Title Bar -->
            <!-- ============================================================ -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgMidBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo + App name -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Border Width="28" Height="28"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="4">
                            <TextBlock Text="CS"
                                       FontSize="14"
                                       FontWeight="Black"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource AppTitle}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="MinButton"
                                Width="40" Height="48"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Click="MinButton_Click"
                                Cursor="Hand">
                            <TextBlock Text="—" FontSize="16" FontWeight="Bold" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Width="40" Height="48"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Click="CloseButton_Click"
                                Cursor="Hand">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- Main content: sidebar + view -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgMidBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="True">

                        <!-- Profile section -->
                        <Border DockPanel.Dock="Top"
                                Background="{StaticResource PanelBrush}"
                                Padding="16,20,16,20"
                                Margin="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0"
                                        Width="48" Height="48"
                                        CornerRadius="24"
                                        Background="{StaticResource BgDarkBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="2">
                                    <TextBlock Text="{Binding User.PersonaName,
                                                              Converter={x:Static vm:InitialsConverter.Instance},
                                                              FallbackValue=?}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Name + SteamID -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{Binding User.PersonaName,
                                                              FallbackValue=Гость}"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding User.SteamId,
                                                              FallbackValue=—}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Login / Logout button -->
                        <Border DockPanel.Dock="Top"
                                Padding="12,8,12,8">
                            <StackPanel>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding LoginCommand}"
                                        Visibility="{Binding User.IsLoggedIn,
                                                              Converter={x:Static vm:InverseBoolToVisConverter.Instance},
                                                              FallbackValue=Visible}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎮" Margin="0,0,8,0" />
                                        <TextBlock Text="{DynamicResource LoginSteam}" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding LogoutCommand}"
                                        Visibility="{Binding User.IsLoggedIn,
                                                              Converter={x:Static vm:BoolToVisConverter.Instance},
                                                              FallbackValue=Collapsed}">
                                    <TextBlock Text="{DynamicResource Logout}" />
                                </Button>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="120" Height="2"
                                                 Visibility="{Binding IsLoggingIn,
                                                                      Converter={x:Static vm:BoolToVisConverter.Instance},
                                                                      FallbackValue=Collapsed}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============================================================ -->
                        <!-- Навигация с разделением по играм                              -->
                        <!-- ============================================================ -->
                        <ScrollViewer DockPanel.Dock="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="0,8,0,0">

                            <StackPanel>

                                <!-- === Раздел CS2 === -->
                                <TextBlock Text="COUNTER-STRIKE 2"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Margin="20,8,20,4"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- CS2: Запуск -->
                                <Button Style="{StaticResource NavButton}"
                                        Tag="{Binding CurrentFullPage,
                                                      Converter={x:Static vm:SectionActiveConverter.Instance},
                                                      ConverterParameter=CS2:Launch,
                                                      FallbackValue=Inactive}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="CS2:Launch"
                                        Margin="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" FontSize="14" Margin="0,0,12,0"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                        <TextBlock Text="Запуск"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                    </StackPanel>
                                </Button>

                                <!-- CS2: Конфиг -->
                                <Button Style="{StaticResource NavButton}"
                                        Tag="{Binding CurrentFullPage,
                                                      Converter={x:Static vm:SectionActiveConverter.Instance},
                                                      ConverterParameter=CS2:Config,
                                                      FallbackValue=Inactive}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="CS2:Config"
                                        Margin="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="14" Margin="0,0,12,0"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                        <TextBlock Text="Конфиг"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                    </StackPanel>
                                </Button>

                                <!-- CS2: Статистика -->
                                <Button Style="{StaticResource NavButton}"
                                        Tag="{Binding CurrentFullPage,
                                                      Converter={x:Static vm:SectionActiveConverter.Instance},
                                                      ConverterParameter=CS2:Stats,
                                                      FallbackValue=Inactive}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="CS2:Stats"
                                        Margin="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" FontSize="14" Margin="0,0,12,0"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                        <TextBlock Text="Статистика"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                    </StackPanel>
                                </Button>

                                <!-- CS2: Гранаты -->
                                <Button Style="{StaticResource NavButton}"
                                        Tag="{Binding CurrentFullPage,
                                                      Converter={x:Static vm:SectionActiveConverter.Instance},
                                                      ConverterParameter=CS2:Grenades,
                                                      FallbackValue=Inactive}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="CS2:Grenades"
                                        Margin="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💣" FontSize="14" Margin="0,0,12,0"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                        <TextBlock Text="Гранаты"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                    </StackPanel>
                                </Button>

                                <!-- === Раздел ARC Raiders === -->
                                <TextBlock Text="ARC RAIDERS"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Margin="20,16,20,4"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- ARC: Запуск -->
                                <Button Style="{StaticResource NavButton}"
                                        Tag="{Binding CurrentFullPage,
                                                      Converter={x:Static vm:SectionActiveConverter.Instance},
                                                      ConverterParameter=ARC:Launch,
                                                      FallbackValue=Inactive}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="ARC:Launch"
                                        Margin="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" FontSize="14" Margin="0,0,12,0"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                        <TextBlock Text="Запуск"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                    </StackPanel>
                                </Button>

                                <!-- ARC: Настройки -->
                                <Button Style="{StaticResource NavButton}"
                                        Tag="{Binding CurrentFullPage,
                                                      Converter={x:Static vm:SectionActiveConverter.Instance},
                                                      ConverterParameter=ARC:Config,
                                                      FallbackValue=Inactive}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="ARC:Config"
                                        Margin="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="14" Margin="0,0,12,0"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                        <TextBlock Text="Настройки"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                    </StackPanel>
                                </Button>

                                <!-- ARC: Моды -->
                                <Button Style="{StaticResource NavButton}"
                                        Tag="{Binding CurrentFullPage,
                                                      Converter={x:Static vm:SectionActiveConverter.Instance},
                                                      ConverterParameter=ARC:Mods,
                                                      FallbackValue=Inactive}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="ARC:Mods"
                                        Margin="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦" FontSize="14" Margin="0,0,12,0"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                        <TextBlock Text="Моды"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                                        Path=Foreground}" />
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Language toggle + Update banner -->
                        <StackPanel DockPanel.Dock="Bottom"
                                    Margin="12,0,12,8">

                            <!-- Баннер обновления (показывается только если есть апдейт) -->
                            <Border Background="#1A1A20"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2,0,0,0"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding UpdateAvailable,
                                                          Converter={x:Static vm:BoolToVisConverter.Instance}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎉"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Новая версия доступна"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding UpdateVersion, StringFormat='v{0}'}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DownloadUpdateCommand}"
                                            Padding="10,6"
                                            Margin="0,8,0,0"
                                            FontSize="11">
                                        <TextBlock Text="Загрузить" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Строка с проверкой обновлений -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <TextBlock Text="v1.0.0"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Style="{x:Null}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Command="{Binding CheckUpdatesCommand}"
                                        Cursor="Hand"
                                        Padding="4,2"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsCheckingUpdates,
                                                            Converter={x:Static vm:InverseBoolConverter.Instance}}">
                                    <TextBlock Text="🔄 Проверить обновления"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="10" />
                                </Button>
                            </StackPanel>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ToggleLanguageCommand}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="🌐" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding LanguageCode}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Spacer -->
                        <Border Background="Transparent" />
                    </DockPanel>
                </Border>

                <!-- Content -->
                <Border Grid.Column="1"
                        Background="{StaticResource BgDarkBrush}">
                    <Grid>
                        <ContentControl Content="{Binding CurrentViewModel}">
                            <ContentControl.Resources>
                                <!-- CS2 -->
                                <DataTemplate DataType="{x:Type vm:LaunchViewModel}">
                                    <views:LaunchView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
                                    <views:ConfigView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:StatsViewModel}">
                                    <views:StatsView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:GrenadesViewModel}">
                                    <views:GrenadesView />
                                </DataTemplate>
                                <!-- ARC Raiders — каждый ViewModel со своим View -->
                                <DataTemplate DataType="{x:Type vm:ArcRaidersLaunchViewModel}">
                                    <views:ArcRaidersLaunchView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:ArcRaidersConfigViewModel}">
                                    <views:ArcRaidersConfigView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:ArcRaidersModsViewModel}">
                                    <views:ArcRaidersModsView />
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- Status Bar -->
            <!-- ============================================================ -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgMidBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage,
                                              FallbackValue=Готово}"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="1"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0">
                        <Run Text="{DynamicResource FooterVersion}" />
                        <Run Text="1.0.0" />
                        <Run Text="•" />
                        <Run Text="{DynamicResource FooterNote}" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
